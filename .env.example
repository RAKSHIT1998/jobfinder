# Required in production — without these the admin console uses insecure defaults.
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# Optional — absolute path to the SQLite file. Point this at your platform's
# persistent volume mount (e.g. /data/data.db) so data survives redeploys.
# Defaults to ./data.db in the project root if unset.
DB_PATH=

# Required to accept real payments. Get these from the Stripe Dashboard
# (Developers > API keys). Use sk_test_... while testing, sk_live_... in prod.
STRIPE_SECRET_KEY=

# Required for the webhook at /api/stripe/webhook to verify events came from
# Stripe. Get this when you create the webhook endpoint (Developers > Webhooks),
# or from `stripe listen` when testing locally with the Stripe CLI.
STRIPE_WEBHOOK_SECRET=
