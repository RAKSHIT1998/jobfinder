# Required in production - without these the admin console uses insecure defaults.
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# Optional - absolute path to the SQLite file. Point this at your platform's
# persistent volume mount (e.g. /data/data.db) so data survives redeploys.
# Defaults to ./data.db in the project root if unset.
DB_PATH=

# Required to accept payments with Cashfree.
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=

# Use sandbox for test keys and production for live keys.
CASHFREE_ENV=sandbox
NEXT_PUBLIC_CASHFREE_MODE=sandbox

# Required for Cover Letter Generator and AI Interview Coach. Get one at
# console.anthropic.com (API Keys). Without this, those two features return
# a clear "not configured" error instead of fake content.
ANTHROPIC_API_KEY=
