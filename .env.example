# Required in production - without these the admin console uses insecure defaults.
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# Required in production - signs regular user login sessions (separate from
# the admin secret above so compromising one doesn't compromise the other).
SESSION_SECRET=

# Required - MongoDB Atlas connection string (mongodb+srv://...).
MONGODB_URI=

# Required to accept payments with Cashfree.
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=

# Use sandbox for test keys and production for live keys.
CASHFREE_ENV=sandbox
NEXT_PUBLIC_CASHFREE_MODE=sandbox

# Optional - comma-separated list of currencies your Cashfree merchant
# account is approved to charge in. INR works for every account out of the
# box, so it's the safe default. Cashfree's "Multi-Currency"/international
# payments feature must be enabled via their support form before you can add
# anything else (e.g. INR,USD,GBP,EUR,AUD,SGD) - the checkout always shows
# the visitor's local currency, but the actual Cashfree charge falls back to
# the first currency in this list if their currency isn't enabled.
CASHFREE_SUPPORTED_CURRENCIES=INR

# Required for Cover Letter Generator and AI Interview Coach. Get one at
# console.anthropic.com (API Keys). Without this, those two features return
# a clear "not configured" error instead of fake content.
ANTHROPIC_API_KEY=

# Optional - adds Adzuna as a 5th live job source, via their official free
# API (not scraping). Get a free app_id/app_key at developer.adzuna.com.
# Without these, the other 4 sources (Arbeitnow, The Muse, RemoteOK, Jobicy)
# still work fine - Adzuna just doesn't activate.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Optional - comma-separated Adzuna country codes to pull from (see
# https://api.adzuna.com/v1/api for the supported list). Defaults to India,
# since that's the gap the other 4 (tech/remote-leaning) sources leave.
ADZUNA_COUNTRIES=in

# Optional - sends the "welcome + shortlisted jobs" email on registration.
# Without SMTP_USER/SMTP_PASS, sendMail() logs a warning and skips silently -
# registration itself never fails because of email.
#
# Gmail setup: enable 2-Step Verification on the sending account, then create
# an App Password at https://myaccount.google.com/apppasswords (regular Gmail
# passwords are rejected by SMTP). Use that App Password as SMTP_PASS.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Optional - defaults to SMTP_USER if unset. Accepts "Name <email>" format.
SMTP_FROM=

# Optional - absolute origin used for links inside emails (e.g.
# "https://jobfinderai.com"). Defaults to a placeholder if unset.
SITE_URL=
